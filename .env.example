# YouTube Data API v3 key (https://console.cloud.google.com/)
YOUTUBE_API_KEY=your_youtube_api_key_here

GEMINI_API_KEY=your_gemini_api_key_here

# Database (PostgreSQL)
DATABASE_URL=postgresql://tube_agent:tube_agent_dev@localhost:5432/tube_agent

# Redis (Celery broker)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Supabase Auth (optional)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (optional)
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=tube-agent

# CORS allowed origins (comma-separated, use * for dev only)
CORS_ORIGINS=http://localhost:3000
