# YouTube Data API v3 key (https://console.cloud.google.com/)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Per-OS app data directory. Empty = platform default
# (e.g. ~/Library/Application Support/tube-agent on macOS,
#  ~/.local/share/tube-agent on Linux, %APPDATA%/tube-agent on Windows).
# APP_DATA_DIR=

# Database. Empty = derived from APP_DATA_DIR as sqlite:///{app_data_dir}/tube_agent.db
# Set explicitly only when pointing at an external Postgres or a custom path.
# DATABASE_URL=sqlite:///./tube_agent.db

# CORS allowed origins (comma-separated, use * for dev only)
CORS_ORIGINS=http://localhost:3000
